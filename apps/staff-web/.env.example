# Copy to .env.local and restart `npm run dev`.

# --- Option A (recommended when API is on another PC): Vite dev proxy ---
# Browser only calls localhost:5173; Vite forwards /api and /hubs to the target.
VITE_DEV_USE_PROXY=true
VITE_DEV_API_PROXY_TARGET=http://YOUR_WINDOWS_LAN_IP:5154

# --- Option B: browser calls API directly (127.0.0.1 = the machine running the browser) ---
# VITE_API_URL=http://127.0.0.1:5154
# VITE_API_URL=http://YOUR_WINDOWS_LAN_IP:5154
